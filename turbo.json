{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.test*"
      ],
      "outputs": [
        "coverage/**"
      ],
      "passThroughEnv": [
        "DATABASE_URL",
        "SYSTEM_DATABASE_URL",
        "DIRECT_URL",
        "REDIS_URL",
        "JWT_SECRET",
        "DEV_TENANT_SLUG",
        "SUPABASE_*",
        "VITE_*",
        "E2E_*",
        "TEST_*",
        "RATE_LIMIT_*",
        "NODE_ENV",
        "CI"
      ]
    },
    "test:unit": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env.test*"
      ],
      "outputs": [
        "coverage/**"
      ],
      "passThroughEnv": [
        "DATABASE_URL",
        "SYSTEM_DATABASE_URL",
        "DIRECT_URL",
        "REDIS_URL",
        "JWT_SECRET",
        "DEV_TENANT_SLUG",
        "SUPABASE_*",
        "VITE_*",
        "E2E_*",
        "TEST_*",
        "RATE_LIMIT_*",
        "NODE_ENV",
        "CI"
      ]
    },
    "test:integration": {
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$"
      ],
      "passThroughEnv": [
        "DATABASE_URL",
        "SYSTEM_DATABASE_URL",
        "DIRECT_URL",
        "REDIS_URL",
        "JWT_SECRET",
        "DEV_TENANT_SLUG",
        "SUPABASE_*",
        "VITE_*",
        "E2E_*",
        "TEST_*",
        "RATE_LIMIT_*",
        "NODE_ENV",
        "CI"
      ]
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "SYSTEM_DATABASE_URL",
        "DIRECT_URL",
        "REDIS_URL",
        "JWT_SECRET",
        "DEV_TENANT_SLUG",
        "SUPABASE_*",
        "VITE_*",
        "E2E_*",
        "TEST_*",
        "RATE_LIMIT_*",
        "NODE_ENV",
        "CI"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "type-check": {
      "dependsOn": [
        "^build"
      ]
    }
  }
}
