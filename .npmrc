# node-linker=hoisted: pnpm-г npm шиг flat, symlink-гүй node_modules ашиглуулна.
# shamefully-hoist=true ашигладаг ч pnpm symlink хийдэг тул .prisma binary
# node_modules/.pnpm/... дотор үлддэг — Dockerfile COPY алддаг.
# node-linker=hoisted бол бодит файл бүтэц үүсгэдэг тул .prisma root-д гарч ирнэ.
node-linker=hoisted
