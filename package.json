{
  "name": "s-project",
  "version": "0.0.1",
  "private": true,
  "description": "S Project — Multi-Tenant Supply Chain Management Platform",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:push": "cd apps/core-kernel && npx prisma db push",
    "db:generate": "cd apps/core-kernel && npx prisma generate",
    "db:migrate": "cd apps/core-kernel && npx prisma migrate deploy",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "playwright:install": "node node_modules/@playwright/test/cli.js install chromium",
    "e2e": "pnpm --filter e2e test",
    "e2e:ui": "pnpm --filter e2e test:ui"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.4.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
