# ============================================================
# S Project — Environment Variables
# Хуулж .env болгон өөрийн утгыг оруулна уу
# ============================================================

# Server
NODE_ENV=development
PORT=3000

# Supabase Local (supabase start үед автоматаар үүснэ)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
SUPABASE_ANON_KEY="your-anon-key-here"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT (32+ тэмдэгт — production-д аюулгүй random string ашиглана)
JWT_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_OF_32_PLUS_CHARS"

# Development
DEV_TENANT_SLUG="test-tenant"
