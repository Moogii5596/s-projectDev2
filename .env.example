# ============================================================
# S Project — Environment Variables
# Хуулж .env болгон өөрийн утгыг оруулна уу
# ============================================================

# Server
NODE_ENV=development
PORT=3000

# Supabase Local (pnpm supabase:start үед автоматаар үүснэ)
# DATABASE_URL = апп-ын холболт → app_user (NOBYPASSRLS) — RLS бодитоор идэвхтэй (production-тэй ижил).
#   Апп асахад: `DB role "app_user" — RLS идэвхтэй`. postgres-оор бол RLS алгасагдана (WARN лог).
#   app_user нууц үг (migration 0002_rls_policies): local = change_in_production; production-д заавал солино (VPC runbook).
DATABASE_URL="postgresql://app_user:change_in_production@127.0.0.1:54322/postgres?schema=public"
# SYSTEM_DATABASE_URL = системийн холболт (BYPASSRLS): tenant lookup, login, super-admin, onboarding, outbox, DLQ, escalation,
#   integration тестийн бэлтгэл, `pnpm dev:test-user`, e2e fixture. Заавал тохируулна.
SYSTEM_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"
# Prisma migrate/introspect (superuser шаардлагатай)
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"
SUPABASE_ANON_KEY="your-anon-key-here"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT (32+ тэмдэгт — production-д аюулгүй random string ашиглана)
JWT_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_OF_32_PLUS_CHARS"

# Development
DEV_TENANT_SLUG="test-tenant"

# Deployment mode (ADR-001): shared = SaaS, олон tenant + RLS (default)
#                             dedicated = Enterprise VPC, нэг deploy = нэг tenant
DEPLOYMENT_MODE="shared"
# DEDICATED_TENANT_SLUG=""    # зөвхөн dedicated үед заавал (docker/.env.vpc.example-г үз)

# Debug-only модулиудыг зөвшөөрөх (production/pilot анхдагчаар унтраалттай)
DEBUG_MENU_ENABLED=false

# v0.2.5 H1 (#16): бүртгэлийн нэвтрэлтийн түгжээ (NestJS, auth_guard.password_failures) — WINDOW мин-д MAX буруу → DURATION мин
AUTH_LOCK_MAX_FAILURES=5
AUTH_LOCK_WINDOW_MINUTES=15
AUTH_LOCK_DURATION_MINUTES=15
# true = self-hosted GoTrue-ийн password hook (deploy/*/supabase/config.toml) асаалттай → буруу оролдлогыг hook тоолно (давхар тоолохгүй).
# Supabase Cloud (Free) дээр hook байхгүй → false.
AUTH_LOCK_GOTRUE_HOOK=false

# Tenant rate limit (Phase 3.1) — 1с / 10с / 60с цонх тус бүрийн хүсэлтийн тоо
# Load test-д: RATE_LIMIT_SHORT=1000000 RATE_LIMIT_MEDIUM=1000000 RATE_LIMIT_LONG=1000000
RATE_LIMIT_SHORT=100
RATE_LIMIT_MEDIUM=500
RATE_LIMIT_LONG=2000

# Cluster (main.ts, production `pnpm start`): worker тоо, унасан worker-ийг дахин асаах backoff (Phase 3.6.4)
NODE_CLUSTER_WORKERS=1
# CLUSTER_RESTART_BASE_MS=1000
# CLUSTER_RESTART_MAX_MS=30000
# CLUSTER_RESTART_WINDOW_MS=60000

# Prisma лог (Phase 3.6.6) — анхдагч: query биш warn,error; integration тест = warn
PRISMA_LOG_LEVELS=warn,error

# Автомат escalation (15 мин тутам, SLA хэтэрсэн алхам). v0.1.6: off → унтраана (пилот)
# ESCALATION_CRON=off
# OUTBOX_POLLER_CRON=off  # зөвхөн integration test орчинд
# NOTIFICATION_MAIL_CRON=off  # v0.2.4 NTF-01 — мэдэгдлийн имэйлийн cron (integration тестэд off)

# v0.2.3 Блок 5 (FEED-01): Feed-ийн зургийн хавтас — хоосон бол <repo root>\storage (.gitignore). Пилот: pilot.ps1 PILOT_STORAGE_DIR-ээс дамжуулна; нөөцлөлтөд орно
STORAGE_DIR=
# Зургийн гарын үсэгтэй URL-ийн нууц (заавал биш) — хоосон бол JWT_SECRET-ээс гарган авна. Солиход өмнөх зургийн URL хүчингүй (7–14 хоног)
MEDIA_URL_SECRET=
# v0.2.4 FILE-01 (M-7): хавсралтын AES-256-GCM түлхүүр — base64, 32 байт (openssl rand -base64 32).
# Хоосон бол JWT_SECRET-ээс гаргана (dev/staging). Production-д заавал тусдаа; солиход хуучин файл уншигдахгүй — нөөцөлж хадгална.
FILE_ENCRYPTION_KEY=
# v0.2.4 DBG-01: Debug → Систем-д харагдах build мэдээлэл (CI/pilot.ps1 build-ийн үед)
# GIT_COMMIT=
# BUILD_DATE=
# Пилотын статусын анхааруулах босго (PostgreSQL DB + Feed storage нийлбэр)
PILOT_STORAGE_DB_WARN_GB=10
