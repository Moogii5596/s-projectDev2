# ============================================================
# S Project — v0.2.0 STAGING (шинэчлэлийн дадлага, runbook §13в) — STAGING CLONE-ийн root .env.staging
#   Хуулах:  copy <tools>\deploy\staging\.env.staging.example E:\MoogiiDev\Staging\s-project\.env.staging
#   <...> бүрийг солино. Нууц үг үүсгэх (PowerShell):
#     -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | % {[char]$_})
#   Шалгах: <tools>\deploy\pilot\pilot.ps1 check -Profile staging -Root E:\MoogiiDev\Staging\s-project
# Пилотын нөөцийг сэргээдэг тул ХУВИЙН МЭДЭЭЛЭЛ агуулна. COMMIT ХИЙХГҮЙ, ДАМЖУУЛАХГҮЙ (.gitignore: .env.staging)
# ============================================================

NODE_ENV=production
PORT=3200

# ADR-001: нэг байгууллага = нэг deploy
DEPLOYMENT_MODE=dedicated
DEDICATED_TENANT_SLUG=sinohydro

# ── Өгөгдлийн сан (STAGING Supabase, порт 56522) — пилотын 55322-ийг бичвэл pilot.ps1 зогсооно ──
# app_user нууц үг: ЗӨВХӨН латин үсэг + тоо, 24+ тэмдэгт. pilot.ps1 init/restore нь DB-д тохируулна.
DATABASE_URL="postgresql://app_user:<APP_USER_PASSWORD>@127.0.0.1:56522/postgres?schema=public"
SYSTEM_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:56522/postgres?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:56522/postgres?schema=public"

# Staging-ийн өөрийн DB administrator нууц (пилотоос тусдаа), 32+ random alphanumeric.
PILOT_DB_ADMIN_PASSWORD=<32+ RANDOM>

# ── Supabase Auth ────────────────────────────────────────────
SUPABASE_URL="http://127.0.0.1:56521"
# Supabase-ийн JWT нууц (40+ тэмдэгт) — ПИЛОТЫНХООС ӨӨР шинэ утга
SUPABASE_AUTH_JWT_SECRET=<40+ RANDOM>
# SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY — энд БИЧИХГҮЙ: pilot.ps1 `supabase status`-оос авна

# Апп-ын дотоод нууц (40+ тэмдэгт) — пилотынхоос өөр
JWT_SECRET=<40+ RANDOM>

# ── Redis (staging-ийн тусдаа контейнер, deploy/staging/docker-compose.redis.yml) ──
REDIS_URL=redis://127.0.0.1:56579

# ── Тохиргоо (пилоттой ижил байлгана — тооцоог харьцуулна) ──
# Автомат escalation унтраалттай (алхам алгасах асуудал backlog-д)
ESCALATION_CRON=off
NODE_CLUSTER_WORKERS=1
PRISMA_LOG_LEVELS=warn,error
RATE_LIMIT_SHORT=100
RATE_LIMIT_MEDIUM=500
RATE_LIMIT_LONG=2000

# Web: идэвхтэй модулиуд (camp | all | таслалаар). Солибол pilot.ps1 build
PILOT_MODULES=camp
# Caddy (зөвхөн энэ машинаас: http://127.0.0.1:8089 — Funnel-д НЭЭХГҮЙ)
PILOT_HTTP_PORT=8089

# ── Нөөц ─────────────────────────────────────────────────────
# PILOT_BACKUP_PASSWORD = ПИЛОТЫНХТОЙ ИЖИЛ (пилотын нөөцийг задалж сэргээнэ).
# Staging-ийн өөрийн нөөц (upgrade-ийн өмнө) "staging-<slug>-*.7z" нэртэй — тусдаа хавтсанд.
PILOT_BACKUP_DIR=E:\MoogiiDev\Staging\backups
PILOT_BACKUP_PASSWORD=<ПИЛОТЫНХТОЙ ИЖИЛ>
PILOT_BACKUP_KEEP_DAYS=14
# status/watchdog анхааруулга: PostgreSQL DB + storage нийлбэр хэмжээний босго (GB)
PILOT_STORAGE_DB_WARN_GB=10
# 7z.exe PATH-д байхгүй бол: PILOT_7Z=C:\Program Files\7-Zip\7z.exe

# v0.2.4 FILE-01 (M-7): хавсралтын AES-256-GCM түлхүүр — base64, 32 байт (openssl rand -base64 32).
# Staging-д pilot-ийнхоос ТУСДАА түлхүүр (v0.2.3 → v0.2.4 нөөцөд шифрлэгдсэн хавсралт байхгүй). v0.2.4+ pilot нөөцийг сэргээж хавсралт унших бол pilot-ийн түлхүүр secure сувгаар.
FILE_ENCRYPTION_KEY=<openssl rand -base64 32>
# Зургийн гарын үсэгтэй URL-ийн нууц (заавал биш) — хоосон бол JWT_SECRET-ээс. Солиход өмнөх зургийн URL хүчингүй
MEDIA_URL_SECRET=
# v0.2.4 Debug цэс (DBG-01) — pilot/staging-д анхдагчаар унтраалттай
DEBUG_MENU_ENABLED=false
