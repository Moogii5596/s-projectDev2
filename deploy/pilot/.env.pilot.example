# ============================================================
# S Project — v0.1.6 Кемп пилот (Sino Hydro) — ПИЛОТЫН ХАВТАСНЫ root .env
#   Хуулах:  copy deploy\pilot\.env.pilot.example .env   (E:\MoogiiDev\Pilot\s-project\.env)
#   <...> бүрийг солино. Нууц үг үүсгэх (PowerShell):
#     -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 40 | % {[char]$_})
#   Шалгах: .\deploy\pilot\pilot.ps1 check
# ЭНЭ ФАЙЛЫГ COMMIT ХИЙХГҮЙ, ХЭНД Ч ДАМЖУУЛАХГҮЙ (.gitignore: .env)
# ============================================================

NODE_ENV=production
PORT=3100

# ADR-001: нэг байгууллага = нэг deploy
DEPLOYMENT_MODE=dedicated
DEDICATED_TENANT_SLUG=sinohydro

# ── Өгөгдлийн сан (пилотын Supabase, порт 55322) ─────────────
# app_user нууц үг: ЗӨВХӨН латин үсэг + тоо, 24+ тэмдэгт. pilot.ps1 init/restore нь DB-д тохируулна.
DATABASE_URL="postgresql://app_user:<APP_USER_PASSWORD>@127.0.0.1:55322/postgres?schema=public"
SYSTEM_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55322/postgres?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:55322/postgres?schema=public"

# PILOT_DB_ADMIN_PASSWORD — хасагдсан (ADR-002, 2026-11-11): Supabase CLI local stack DB-д анхдагч нууцаар л холбогддог; бүү тохируул

# ── Supabase Auth ────────────────────────────────────────────
SUPABASE_URL="http://127.0.0.1:55321"
# Supabase-ийн JWT нууц (40+ тэмдэгт). СОЛИВОЛ: бүх хэрэглэгч дахин нэвтэрнэ + pilot.ps1 build (anon key өөрчлөгдөнө)
SUPABASE_AUTH_JWT_SECRET=<40+ RANDOM>
# SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY — энд БИЧИХГҮЙ: pilot.ps1 `supabase status`-оос авна

# Апп-ын дотоод нууц (40+ тэмдэгт)
JWT_SECRET=<40+ RANDOM>

# ── Redis (пилотын тусдаа контейнер, docker-compose.redis.yml) ──
REDIS_URL=redis://127.0.0.1:56379

# ── Пилотын тохиргоо ─────────────────────────────────────────
# Автомат escalation унтраалттай (алхам алгасах асуудал backlog-д)
ESCALATION_CRON=off
NODE_CLUSTER_WORKERS=1
PRISMA_LOG_LEVELS=warn,error
RATE_LIMIT_SHORT=100
RATE_LIMIT_MEDIUM=500
RATE_LIMIT_LONG=2000

# Web: идэвхтэй модулиуд (camp | all | таслалаар). Солибол pilot.ps1 build
PILOT_MODULES=camp
# Caddy (Funnel → энэ порт, 127.0.0.1)
PILOT_HTTP_PORT=8088

# ── Нөөцлөлт (pilot.ps1 backup, өдөр бүр 02:00) ──────────────
# Өөр диск/USB/OneDrive хавтас байвал илүү. Нууц үгийг нууц үгийн менежерт ХАДГАЛ — алдвал нөөцийг сэргээх боломжгүй.
PILOT_BACKUP_DIR=E:\MoogiiDev\Pilot\backups
PILOT_BACKUP_PASSWORD=<24+ RANDOM>
PILOT_BACKUP_KEEP_DAYS=14
# 7z.exe PATH-д байхгүй бол: PILOT_7Z=C:\Program Files\7-Zip\7z.exe
# 2 дахь хуулбар (PIL-05; заавал биш): OneDrive/USB хавтас — PILOT_BACKUP_DIR-ээс ӨӨР. Хадгалах хугацаа = PILOT_BACKUP_KEEP_DAYS
PILOT_BACKUP_COPY_DIR=
# Feed-ийн зургийн хавтас (анхдагч <root>\storage; backend-ийн STORAGE_DIR-тэй ЯГ ИЖИЛ байх). backup/restore-д орно
PILOT_STORAGE_DIR=
# status/watchdog анхааруулга: PostgreSQL DB + storage нийлбэр хэмжээний босго (GB)
PILOT_STORAGE_DB_WARN_GB=10

# ── Мониторинг (PIL-04; заавал биш) ───────────────────────────
# healthchecks.io → 2 check үүсгэ: (1) пилот — Period 10 мин, Grace 10 мин; (2) нөөц — Period 1 өдөр, Grace 2 цаг.
# Ping URL нь нууц үг биш (зөвхөн ping хүлээн авна), гэхдээ нийтэд бүү тавь.
PILOT_HEALTHCHECK_URL=
PILOT_HEALTHCHECK_BACKUP_URL=
# watchdog-ийн ping давтамж (сек). Асуудал гарвал шууд /fail
PILOT_HEALTHCHECK_INTERVAL_SEC=300

# ── Нийтийн хаяг (v0.2.2 D-14, ADR-005; 05_Cloudflare_Tunnel.md) ──
# Хэрэглэгчийн нээдэг хаяг. Урилгын линк (Блок 3) энэ хаягаар үүснэ; `pilot.ps1 status` харуулна.
# Cloudflare Tunnel-ийн токен ЭНД БИШ — cloudflared Windows service-д л (чат/git-ээр дамжуулахгүй).
PUBLIC_APP_URL=https://sino.gobiverse.website

# ── Системийн имэйл (v0.2.2 Блок 3 — урилга, нууц үг сэргээх; заавал биш) ──
# Хоосон бол имэйл суваг идэвхгүй: урилгыг "Линк хуулах"-аар л. Нууц үгийг (SMTP_PASS) чат/git-ээр ДАМЖУУЛАХГҮЙ.
# Gmail: 2FA асаалттай бүртгэл + App password, SMTP_HOST=smtp.gmail.com, SMTP_PORT=587 (өдөрт ~500 хязгаар).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Илгээгч (хоосон бол SMTP_USER), жнь: S Project <noreply@gobiverse.website>
SMTP_FROM=

# v0.2.4 FILE-01 (M-7): хавсралтын AES-256-GCM түлхүүр — base64, 32 байт (openssl rand -base64 32).
# ЗААВАЛ: хоосон бол JWT_SECRET-ээс гарна → JWT солиход бүх хавсралт уншигдахгүй. Солихгүй; нөөцөөс ТУСАД нь нууц үгийн менежерт хадгална (ADR-002).
FILE_ENCRYPTION_KEY=<openssl rand -base64 32>
# Зургийн гарын үсэгтэй URL-ийн нууц (заавал биш) — хоосон бол JWT_SECRET-ээс. Солиход өмнөх зургийн URL хүчингүй
MEDIA_URL_SECRET=
# v0.2.4 Debug цэс (DBG-01) — pilot/staging-д анхдагчаар унтраалттай
DEBUG_MENU_ENABLED=false
