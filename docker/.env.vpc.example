# ============================================================
# S Project — Enterprise VPC (DEPLOYMENT_MODE=dedicated) env
# Хуулж `docker/.env.vpc` болгоно. ⚠️ .env.vpc-г git-д commit хийхгүй.
# Runbook: docs/07_Tech_Stack_and_Environment/03_Enterprise_VPC_Deployment.md
# ============================================================

# Нэг deploy = нэг tenant. bootstrap_dedicated_tenant.sql-ийн `slug`-тай ЯГ ИЖИЛ.
# Хэлбэр: жижиг латин үсэг, тоо, зураас (a-z, 0-9, -)
DEDICATED_TENANT_SLUG=acme

# Харилцагчийн ТУСДАА Supabase (self-hosted эсвэл тусдаа project) — shared SaaS DB биш!
# Апп = app_user (NOBYPASSRLS → RLS идэвхтэй). Нууц үгийг runbook §5.5-аар СОЛИНО (анхдагч change_in_production-ийг бүү үлдээ)
DATABASE_URL=postgresql://app_user:CHANGE_ME_APP_USER@db.internal:5432/postgres?schema=public
# Системийн холболт (BYPASSRLS): tenant lookup, login, outbox, DLQ, escalation (Phase 4.8.4)
SYSTEM_DATABASE_URL=postgresql://postgres:CHANGE_ME@db.internal:5432/postgres?schema=public
DIRECT_URL=postgresql://postgres:CHANGE_ME@db.internal:5432/postgres?schema=public
SUPABASE_URL=https://supabase.acme.internal
SUPABASE_ANON_KEY=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# 32+ тэмдэгт: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_OF_32_PLUS_CHARS

# Сонголттой
NODE_CLUSTER_WORKERS=2
# Tenant rate limit (1с / 10с / 60с) — default 100 / 500 / 2000
RATE_LIMIT_SHORT=100
RATE_LIMIT_MEDIUM=500
RATE_LIMIT_LONG=2000
SHELL_PORT=80
