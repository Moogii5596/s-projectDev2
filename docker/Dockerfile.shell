# ================================================================
# Stage 1: Prune — зөвхөн web-shell-д хэрэгтэй файлуудыг гаргана
# ================================================================
FROM node:22-alpine AS pruner
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app
COPY . .
RUN pnpm dlx turbo prune --scope=@s-project/web-shell --docker

# ================================================================
# Stage 2: Builder — pruned workspace дотор install + build
# ================================================================
FROM node:22-alpine AS builder
RUN corepack enable && corepack prepare pnpm@9 --activate
WORKDIR /app

COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml

RUN pnpm install --frozen-lockfile

COPY --from=pruner /app/out/full/ .

# Vite env args
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
# Relative URL → Vite proxy → nginx /api → backend (CORS-гүй)
ENV VITE_API_BASE_URL=""

RUN pnpm --filter @s-project/web-shell build

# ================================================================
# Stage 3: nginx — Vite build dist-г serve хийнэ
# ================================================================
FROM nginx:alpine AS production

COPY --from=builder /app/apps/web-shell/dist /usr/share/nginx/html
# docker/ folder-с context-тэй харьцангуй байршилд байна
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
