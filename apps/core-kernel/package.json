{
  "name": "@s-project/core-kernel",
  "version": "0.2.0",
  "private": true,
  "description": "S Project Core Kernel — API Gateway, Auth, Module Registry",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/src/main",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:integration": "prisma generate && vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test:load": "pnpm --filter e2e exec tsx tests/load-test.ts",
    "dev:test-user": "tsx src/scripts/dev-test-user.cli.ts",
    "e2e:fixture": "tsx src/scripts/e2e-fixture.cli.ts",
    "pilot": "tsx src/scripts/pilot-admin.cli.ts",
    "camp:snapshot": "tsx src/scripts/camp-snapshot.cli.ts",
    "camp:login-report": "tsx src/scripts/camp-login-report.cli.ts",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@fastify/multipart": "8.3.1",
    "@nestjs/common": "^10.4.7",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.7",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/platform-fastify": "^10.4.7",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/throttler": "^6.7.0",
    "@prisma/client": "^5.22.0",
    "@s-project/i18n": "workspace:*",
    "@s-project/prisma-rls-extension": "workspace:*",
    "@s-project/shared-types": "workspace:*",
    "@supabase/supabase-js": "^2.46.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "exceljs": "4.4.0",
    "ioredis": "^5.4.1",
    "nodemailer": "6.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.7",
    "@swc/core": "^1.7.26",
    "@types/node": "^22.9.1",
    "@types/nodemailer": "6.4.17",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^1.6.0",
    "fastify": "^4.28.1",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "typescript": "^5.4.5",
    "unplugin-swc": "^1.4.4",
    "vitest": "^1.6.0"
  }
}
