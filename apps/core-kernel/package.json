{
  "name": "@s-project/core-kernel",
  "version": "0.2.4",
  "private": true,
  "description": "S Project Core Kernel — API Gateway, Auth, Module Registry",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/src/main",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:integration": "prisma generate && vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "test:load": "pnpm --filter e2e exec tsx tests/load-test.ts",
    "dev:test-user": "tsx src/scripts/dev-test-user.cli.ts",
    "e2e:fixture": "tsx src/scripts/e2e-fixture.cli.ts",
    "pilot": "tsx src/scripts/pilot-admin.cli.ts",
    "camp:snapshot": "tsx src/scripts/camp-snapshot.cli.ts",
    "camp:login-report": "tsx src/scripts/camp-login-report.cli.ts",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@fastify/multipart": "9.4.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-fastify": "^11.2.8",
    "@nestjs/schedule": "^6.1.3",
    "@prisma/client": "^5.22.0",
    "@s-project/i18n": "workspace:*",
    "@s-project/shared-types": "workspace:*",
    "@sentry/nestjs": "^11.12.0",
    "@supabase/supabase-js": "^2.119.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "exceljs": "4.4.0",
    "ioredis": "^5.4.1",
    "nodemailer": "10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "sharp": "0.35.5",
    "thumbhash": "^0.1.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@swc/core": "^1.16.22",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^1.6.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.8",
    "prisma": "^5.22.0",
    "supertest": "^7.3.2",
    "typescript": "^5.4.5",
    "unplugin-swc": "^1.4.4",
    "vitest": "^1.6.0"
  },
  "prisma": {
    "schema": "prisma/schema"
  }
}
