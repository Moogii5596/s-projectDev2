model HrEmployee {
  id             String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  campId         String             @map("camp_id") @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  departmentId   String             @map("department_id") @db.Uuid
  /// NULL = ростергүй (ээлжийн бус)
  crewId         String?            @map("crew_id") @db.Uuid
  employeeCode   String             @map("employee_code")
  /// v0.2.3 Блок D (20261019002): trigger `trg_camp_employees_names` = «овог нэр» (last_name + first_name). Шууд бичихгүй — овог/нэрийг бич.
  fullName       String             @map("full_name")
  /// Ургийн овог
  familyName     String?            @map("family_name")
  /// Овог (эцэг/эхийн нэр)
  lastName       String?            @map("last_name")
  /// Нэр. DB-д NOT NULL — өгөөгүй бол trigger `full_name`-ээс салгаж бөглөнө (тиймээс Prisma-д optional)
  firstName      String?            @map("first_name")
  position       String?
  phone          String?
  /// v0.2.0 (20261011003) — ADR-003 нэвтрэх нэрийн бэлтгэл
  email          String?
  status         CampEmployeeStatus @default(ACTIVE)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  camp             Camp                  @relation(fields: [tenantId, campId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_employees_camp")
  organization     CoreOrganization      @relation(fields: [tenantId, organizationId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_employees_org")
  department       HrDepartment        @relation(fields: [tenantId, campId, departmentId], references: [tenantId, campId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_employees_department")
  crew             HrCrew?             @relation(fields: [tenantId, campId, crewId], references: [tenantId, campId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_employees_crew")
  shiftAdjustments HrShiftAdjustment[]
  movements        HrMovement[]
  stays            CampStay[]
  roomAllocations  CampRoomAllocation[]
  /// v0.2.1 (C-01): каталог; `position` текст v0.2.2 хүртэл зэрэгцээ
  positionId       String?               @map("position_id") @db.Uuid
  /// Ажлын хоолны байршил — ЭЦСИЙН утга (NULL → албан тушаал → кемпийн анхдагч)
  mealLocationId   String?               @map("meal_location_id") @db.Uuid
  /// Хоол авах эсэх — ЭЦСИЙН (NULL → албан тушаал → тийм)
  mealsIncluded    Boolean?              @map("meals_included")
  /// v0.2.2 (20261013004) — нэвтрэх эрх (1:1; uq_camp_employees_user — зөвхөн migration-д)
  userId           String?               @map("user_id") @db.Uuid
  user             CoreUser?             @relation("CampEmployeeUser", fields: [tenantId, userId], references: [tenantId, id], onDelete: SetNull, onUpdate: NoAction, map: "fk_camp_employees_user")
  /// v0.2.2 Блок 5 (20261017002) — ажлаас гарсан огноо (TERMINATED ⇔ огноо + шалтгаан, ck_camp_employees_terminated)
  terminatedAt      DateTime?              @map("terminated_at") @db.Date
  terminationReason CampTerminationReason? @map("termination_reason")
  terminationNote   String?                @map("termination_note")
  /// Дахин ажилд авсан бол хуучин бүртгэл (нэгээс нэг — uq_camp_employees_rehired_from, зөвхөн migration-д)
  rehiredFromId     String?                @map("rehired_from_id") @db.Uuid
  rehiredFrom       HrEmployee?            @relation("HrEmployeeRehire", fields: [tenantId, rehiredFromId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_employees_rehired_from")
  rehiredAs         HrEmployee[]           @relation("HrEmployeeRehire")
  piiAccessLogs     CampPiiAccessLog[]
  /// v0.2.3 Блок D: нэмэлт утас (үндсэн = `phone`)
  extraPhones       HrEmployeePhone[]
  /// v0.2.3 Блок D (S9, 20261019003): «Мэдээлэл дутуу» — [{ field, code, value }] (импортын буруу утга; талбарыг засахад арилна)
  dataIssues        Json                   @default("[]") @map("data_issues")
  positionRef      HrPosition?         @relation(fields: [tenantId, positionId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_employees_position")
  workMealLocation CampMealLocation?     @relation("CampEmployeeWorkMealLocation", fields: [tenantId, campId, mealLocationId], references: [tenantId, campId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_employees_meal_location")

  @@unique([tenantId, id], map: "uq_camp_employees_tenant_id")
  @@unique([tenantId, campId, id], map: "uq_camp_employees_camp_id")
  /// uq_camp_employees_code = partial unique (status <> 'TERMINATED', Q-C2) — Prisma дэмжихгүй тул зөвхөн migration-д (20261017002)
  @@index([tenantId, employeeCode], map: "idx_camp_employees_code")
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_camp_employees_cursor")
  @@index([tenantId, departmentId], map: "idx_camp_employees_department")
  @@index([tenantId, organizationId], map: "idx_camp_employees_org")
  @@map("camp_employees")
}

