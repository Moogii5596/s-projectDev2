  campId         String   @map("camp_id") @db.Uuid
  positionId     String   @map("position_id") @db.Uuid
  /// NULL = кемпийн анхдагч
  mealLocationId String?  @map("meal_location_id") @db.Uuid
  /// NULL = тийм
  mealsIncluded  Boolean? @map("meals_included")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  position      HrPosition               @relation(fields: [tenantId, positionId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_camp_position_settings_position")
  mealLocation  CampMealLocation?          @relation(fields: [tenantId, campId, mealLocationId], references: [tenantId, campId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_position_settings_location")
  shiftPatterns CampPositionShiftPattern[]

  @@unique([tenantId, id], map: "uq_camp_position_settings_tenant_id")
  @@unique([tenantId, campId, positionId], map: "uq_camp_position_settings_camp_position")
  @@map("camp_position_settings")
}

model CampPositionShiftPattern {
  id                String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId          String        @map("tenant_id") @db.Uuid
  positionSettingId String        @map("position_setting_id") @db.Uuid
  dayFrom           Int           @map("day_from") @db.SmallInt
  dayTo             Int           @map("day_to") @db.SmallInt
  shift             CampShiftType
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  setting CampPositionSetting @relation(fields: [tenantId, positionSettingId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_camp_position_shift_patterns_setting")

  @@index([tenantId, positionSettingId, dayFrom], map: "idx_camp_position_shift_patterns_setting")
  @@map("camp_position_shift_patterns")
}

/// Байрны төрөл — админ үүсгэнэ (Q4)
model CampBuildingType {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  buildings CampBuilding[]

  @@unique([tenantId, id], map: "uq_camp_building_types_tenant_id")
  @@map("camp_building_types")
}

/// v0.2.2 Блок 3 (20261013005) — урилга / нууц үг сэргээх
enum CoreInvitePurpose {
  INVITE
  RESET
}

enum CoreInviteChannel {
  LINK
  EMAIL
}

/// v0.2.2 Блок 3 (ADR-003 §2.3, D-03) — токены SHA-256 hash л хадгална (токен өөрөө хэзээ ч үгүй)
model CoreUserInvite {
  id        String            @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  tokenHash String            @unique(map: "uq_core_user_invites_token") @map("token_hash")
  purpose   CoreInvitePurpose
  channel   CoreInviteChannel
  expiresAt DateTime          @map("expires_at") @db.Timestamptz
  usedAt    DateTime?         @map("used_at") @db.Timestamptz
  revokedAt DateTime?         @map("revoked_at") @db.Timestamptz
  createdBy String?           @map("created_by") @db.Uuid
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  user CoreUser @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_core_user_invites_user")

  @@map("core_user_invites")
}

/// v0.2.2 Блок 5 (20261017003, PIL-03, D-08) — ажилтны хувийн мэдээлэл (профайл) үзсэн лог. Зөвхөн нэмэх (app_user: SELECT, INSERT).
model CampPiiAccessLog {
  id           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  viewerUserId String   @map("viewer_user_id") @db.Uuid
  employeeId   String   @map("employee_id") @db.Uuid
  /// 'profile'
  context      String
  viewedAt     DateTime @default(now()) @map("viewed_at") @db.Timestamptz

  viewer   CoreUser   @relation("CampPiiViewer", fields: [tenantId, viewerUserId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_camp_pii_viewer")
  employee HrEmployee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_camp_pii_employee")

  @@index([tenantId, employeeId, viewedAt(sort: Desc)], map: "idx_camp_pii_access_employee")
  @@index([tenantId, viewerUserId, employeeId, viewedAt(sort: Desc)], map: "idx_camp_pii_access_viewer")
  @@map("camp_pii_access_log")
}

/// v0.2.3 Блок D (20261019002) — ажилтны НЭМЭЛТ утас (үндсэн дугаар = camp_employees.phone)
model HrEmployeePhone {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  phone      String
  sortOrder  Int      @default(0) @map("sort_order") @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employee HrEmployee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction, map: "camp_employee_phones_tenant_id_employee_id_fkey")

  @@unique([tenantId, employeeId, phone], map: "uq_camp_employee_phones")
  @@index([tenantId, employeeId, sortOrder], map: "idx_camp_employee_phones_employee")
  @@map("camp_employee_phones")
}

/// v0.2.3 Блок F (20261019004, FB-SYS-01a) — санал хүсэлтийн төрөл
enum CoreFeedbackKind {
  BUG
  IDEA
  REQUEST
}

/// v0.2.3 Блок F — NEW → ACCEPTED → PLANNED → DONE (+ REJECTED)
enum CoreFeedbackStatus {
  NEW
  ACCEPTED
  PLANNED
  DONE
  REJECTED
}

/// v0.2.3 Блок F (20261019004) — санал хүсэлт / хөгжүүлэлтийн захиалга. Бүгд харна, төлөв/хариу — OWNER/ADMIN.
model CoreFeedback {
  id          String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  authorId    String             @map("author_id") @db.Uuid
  kind        CoreFeedbackKind
  title       String
  body        String             @default("")
  pagePath    String?            @map("page_path")
  appVersion  String?            @map("app_version")
  status      CoreFeedbackStatus @default(NEW)
  adminReply  String?            @map("admin_reply")
  repliedBy   String?            @map("replied_by") @db.Uuid
  repliedAt   DateTime?          @map("replied_at") @db.Timestamptz
  doneVersion String?            @map("done_version")
  voteCount   Int                @default(0) @map("vote_count")
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  author  CoreUser           @relation("CoreFeedbackAuthor", fields: [tenantId, authorId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_core_feedback_author")
  replier CoreUser?          @relation("CoreFeedbackReplier", fields: [tenantId, repliedBy], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_core_feedback_replied_by")
  votes   CoreFeedbackVote[]

  @@unique([tenantId, id], map: "uq_core_feedback_tenant_id")
  @@index([tenantId, status, createdAt(sort: Desc)], map: "idx_core_feedback_list")
  @@index([tenantId, authorId], map: "idx_core_feedback_author")
  @@map("core_feedback")
}

/// v0.2.3 Блок F (20261019004) — «+1» (хэрэглэгч бүр нэг удаа)
model CoreFeedbackVote {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  feedbackId String   @map("feedback_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  feedback CoreFeedback @relation(fields: [tenantId, feedbackId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_core_feedback_votes_feedback")
  user     CoreUser     @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_core_feedback_votes_user")

  @@unique([feedbackId, userId], map: "uq_core_feedback_votes")
  @@index([tenantId, userId], map: "idx_core_feedback_votes_user")
  @@map("core_feedback_votes")
}
