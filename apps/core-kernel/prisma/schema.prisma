// ── v0.2.0 §0.4 — Кемпийн өөрчлөлтийн түүх (20261011001) ─────
/// Append-only (app_user: SELECT, INSERT). FK (tenant, actor → core_users; tenant, camp → camps) нь DB-д;
/// Prisma relation-гүй — хуучин model-уудыг өөрчлөхгүйн тулд (зөвхөн нэмэлт).
model CampAuditLog {
  id            String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId      String          @map("tenant_id") @db.Uuid
  campId        String?         @map("camp_id") @db.Uuid
  entityType    String          @map("entity_type")
  entityId      String          @map("entity_id") @db.Uuid
  action        CampAuditAction
  actorUserId   String          @map("actor_user_id") @db.Uuid
  /// Орчуулгын түлхүүр (жнь audit.employee.update) + параметр
  summaryKey    String          @map("summary_key")
  summaryParams Json            @default("{}") @map("summary_params")
  /// { талбар: { from, to } }
  diff          Json            @default("{}")
  importId      String?         @map("import_id") @db.Uuid
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz

  @@index([tenantId, entityType, entityId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_camp_audit_entity")
  @@index([tenantId, campId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_camp_audit_camp")
  @@map("camp_audit_log")
}

