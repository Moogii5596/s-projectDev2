// Кемп: гэрээ, үнэ — S Project Prisma schema (хэсэг; ерөнхий дүрэм → _base.prisma)

enum CampContractStatus {
  DRAFT
  ACTIVE
  TERMINATED
}

enum CampServiceType {
  SEWAGE_TRANSPORT
  SEWAGE_DISPOSAL
  WASTE_TRANSPORT
  WASTE_DISPOSAL
  MEAL
}

enum CampContractUnit {
  TRIP
  M3
  TON
  PERSON_DAY
}

// ── 1.5 Гэрээ ────────────────────────────────────────────────
model CampContract {
  id             String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId       String             @map("tenant_id") @db.Uuid
  campId         String             @map("camp_id") @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  contractNo     String             @map("contract_no")
  title          String
  startDate      DateTime           @map("start_date") @db.Date
  /// NULL = хугацаагүй
  endDate        DateTime?          @map("end_date") @db.Date
  status         CampContractStatus @default(DRAFT)
  terminatedAt   DateTime?          @map("terminated_at") @db.Date
  note           String?
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  camp         Camp               @relation(fields: [tenantId, campId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_contracts_camp")
  organization CoreOrganization   @relation(fields: [tenantId, organizationId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_contracts_org")
  items        CampContractItem[]

  @@unique([tenantId, id], map: "uq_camp_contracts_tenant_id")
  @@unique([tenantId, campId, id], map: "uq_camp_contracts_camp_id")
  @@unique([tenantId, contractNo], map: "uq_camp_contracts_no")
  @@index([tenantId, campId, status, startDate, endDate], map: "idx_camp_contracts_active")
  @@index([tenantId, organizationId], map: "idx_camp_contracts_org")
  @@map("camp_contracts")
}

/// MEAL ⇔ PERSON_DAY (CHECK). campId-г гэрээнээс давтан хадгална (бүртгэл зөвхөн өөрийн кемпийн гэрээг сонгоно)
model CampContractItem {
  id          String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  campId      String           @map("camp_id") @db.Uuid
  contractId  String           @map("contract_id") @db.Uuid
  serviceType CampServiceType  @map("service_type")
  unit        CampContractUnit
  description String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contract           CampContract            @relation(fields: [tenantId, campId, contractId], references: [tenantId, campId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_camp_contract_items_contract")
  prices             CampContractItemPrice[]
  haulTransport      CampHaulRecord[]        @relation("CampHaulTransportItem")
  haulDisposal       CampHaulRecord[]        @relation("CampHaulDisposalItem")
  mealOrders         CampMealOrder[]
  costEntries        CampCostEntry[]

  @@unique([tenantId, id], map: "uq_camp_contract_items_tenant_id")
  @@unique([tenantId, campId, id], map: "uq_camp_contract_items_camp_id")
  @@unique([contractId, serviceType], map: "uq_camp_contract_items_service")
  @@index([tenantId, campId, serviceType], map: "idx_camp_contract_items_service")
  @@map("camp_contract_items")
}

/// Тухайн өдрийн үнэ = effectiveFrom <= D-ийн хамгийн сүүлийнх
model CampContractItemPrice {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  contractItemId String   @map("contract_item_id") @db.Uuid
  effectiveFrom  DateTime @map("effective_from") @db.Date
  unitPrice      Decimal  @map("unit_price") @db.Decimal(18, 2)
  vatIncluded    Boolean  @map("vat_included")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  contractItem CampContractItem @relation(fields: [tenantId, contractItemId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_camp_contract_item_prices_item")

  @@unique([contractItemId, effectiveFrom], map: "uq_camp_contract_item_prices")
  @@index([tenantId, contractItemId, effectiveFrom(sort: Desc)], map: "idx_camp_contract_item_prices_lookup")
  @@map("camp_contract_item_prices")
}
