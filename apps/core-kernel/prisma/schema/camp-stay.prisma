// Кемп: байрлалт, өрөөний хуваарилалт — S Project Prisma schema (хэсэг; ерөнхий дүрэм → _base.prisma)

/// "Байгаа эсэх"-ийн цорын ганц эх сурвалж. Давхцал → EXCLUDE; movement-ийн чиглэл/огноо → trigger
model CampStay {
  id                  String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  campId              String    @map("camp_id") @db.Uuid
  employeeId          String    @map("employee_id") @db.Uuid
  arrivalMovementId   String    @unique(map: "uq_camp_stays_arrival") @map("arrival_movement_id") @db.Uuid
  departureMovementId String?   @unique(map: "uq_camp_stays_departure") @map("departure_movement_id") @db.Uuid
  startDate           DateTime  @map("start_date") @db.Date
  endDate             DateTime? @map("end_date") @db.Date
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant            Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  employee          HrEmployee  @relation(fields: [tenantId, campId, employeeId], references: [tenantId, campId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_stays_employee")
  arrivalMovement   HrMovement  @relation("CampStayArrival", fields: [tenantId, arrivalMovementId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_stays_arrival")
  departureMovement HrMovement? @relation("CampStayDeparture", fields: [tenantId, departureMovementId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_stays_departure")

  @@index([tenantId, campId, startDate, endDate], map: "idx_camp_stays_presence")
  @@map("camp_stays")
}

/// Ажилтны үндсэн өрөө; өөр багууд хуваалцана. Ажилтны давхцал → EXCLUDE; багтаамж → app (28 хоног)
model CampRoomAllocation {
  id         String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  campId     String    @map("camp_id") @db.Uuid
  roomId     String    @map("room_id") @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  startDate  DateTime  @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  room     CampRoom     @relation(fields: [tenantId, campId, roomId], references: [tenantId, campId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_room_alloc_room")
  employee HrEmployee @relation(fields: [tenantId, campId, employeeId], references: [tenantId, campId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_room_alloc_employee")

  @@index([tenantId, roomId, startDate, endDate], map: "idx_camp_room_alloc_room")
  @@map("camp_room_allocations")
}
