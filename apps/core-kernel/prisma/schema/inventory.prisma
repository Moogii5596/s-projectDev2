// Агуулах, нийлүүлэгч (Phase 4.2/4.3, хөнгөн) — S Project Prisma schema (хэсэг; ерөнхий дүрэм → _base.prisma)

// ============================================================
// Phase 4.2 / 4.3 — хөнгөн модулиуд (supabase/migrations/20261008003_inventory_vendor_lite.sql)
// ============================================================
model InventoryItem {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  sku          String
  name         String
  unit         String   @default("EA")
  quantity     Decimal  @default(0) @db.Decimal(15, 3)
  minThreshold Decimal  @default(0) @map("min_threshold") @db.Decimal(15, 3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, sku], map: "uq_inventory_items_tenant_sku")
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_inventory_items_cursor")
  @@map("inventory_items")
}

model Vendor {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  name      String
  regNumber String?  @map("reg_number")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive, name], map: "idx_vendors_tenant")
  @@map("vendors")
}
