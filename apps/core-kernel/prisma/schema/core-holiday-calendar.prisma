model CoreHolidayCalendar {
  id          String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  code        String
  name        String
  countryCode String?  @map("country_code")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  holidays CoreCalendarHoliday[]

  @@unique([tenantId, id], map: "uq_core_holiday_calendars_tenant_id")
  @@unique([tenantId, code], map: "uq_core_holiday_calendars_code")
  @@map("core_holiday_calendars")
}

model CoreCalendarHoliday {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  calendarId  String    @map("calendar_id") @db.Uuid
  name        String
  recurrence  String
  holidayDate DateTime? @map("holiday_date") @db.Date
  month       Int?
  day         Int?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  calendar CoreHolidayCalendar @relation(fields: [tenantId, calendarId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_core_calendar_holidays_calendar")

  @@unique([tenantId, id], map: "uq_core_calendar_holidays_tenant_id")
  @@index([tenantId, calendarId, holidayDate], map: "idx_core_calendar_holidays_date")
  @@map("core_calendar_holidays")
}
