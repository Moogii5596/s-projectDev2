// Кемп: бохир ус/хог, хоолны захиалга, зардал — S Project Prisma schema (хэсэг; ерөнхий дүрэм → _base.prisma)

enum CampHaulType {
  SEWAGE
  WASTE
}

enum CampVolumeUnit {
  M3
  TON
}

enum CampHaulStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum CampMealOrderStatus {
  DRAFT
  ORDERED
  ACCEPTED
  REJECTED
  CHANGE_REQUESTED
}

enum CampCostSource {
  HAUL
  MEAL
  MAINTENANCE_PART
}

// ── 1.6 Бохир ус/хог, хоол, зардал ───────────────────────────

/// APPROVED → өөрчлөгдөхгүй (trigger); гэрээний төрөл haulType-тай таарна (trigger); reviewedBy ≠ createdBy (CHECK)
model CampHaulRecord {
  id                      String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId                String          @map("tenant_id") @db.Uuid
  campId                  String          @map("camp_id") @db.Uuid
  recordNo                String          @map("record_no")
  haulType                CampHaulType    @map("haul_type")
  haulDate                DateTime        @map("haul_date") @db.Date
  vehicleNo               String?         @map("vehicle_no")
  driverName              String?         @map("driver_name")
  trips                   Int             @default(1)
  volume                  Decimal?        @db.Decimal(15, 3)
  volumeUnit              CampVolumeUnit? @map("volume_unit")
  transportContractItemId String          @map("transport_contract_item_id") @db.Uuid
  disposalContractItemId  String          @map("disposal_contract_item_id") @db.Uuid
  status                  CampHaulStatus  @default(DRAFT)
  note                    String?
  createdBy               String          @map("created_by") @db.Uuid
  submittedAt             DateTime?       @map("submitted_at") @db.Timestamptz
  reviewedBy              String?         @map("reviewed_by") @db.Uuid
  reviewedAt              DateTime?       @map("reviewed_at") @db.Timestamptz
  rejectReason            String?         @map("reject_reason")
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  tenant                Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  camp                  Camp             @relation(fields: [tenantId, campId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_haul_camp")
  transportContractItem CampContractItem @relation("CampHaulTransportItem", fields: [tenantId, campId, transportContractItemId], references: [tenantId, campId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_haul_transport")
  disposalContractItem  CampContractItem @relation("CampHaulDisposalItem", fields: [tenantId, campId, disposalContractItemId], references: [tenantId, campId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_haul_disposal")
  createdByUser         CoreUser         @relation("CampHaulCreatedBy", fields: [tenantId, createdBy], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_haul_created_by")
  reviewedByUser        CoreUser?        @relation("CampHaulReviewedBy", fields: [tenantId, reviewedBy], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_haul_reviewed_by")
  costEntries           CampCostEntry[]

  @@unique([tenantId, id], map: "uq_camp_haul_records_tenant_id")
  @@unique([tenantId, recordNo], map: "uq_camp_haul_records_no")
  @@index([tenantId, campId, haulDate], map: "idx_camp_haul_date")
  @@index([tenantId, campId, status], map: "idx_camp_haul_status")
  @@index([tenantId, createdAt(sort: Desc), id(sort: Desc)], map: "idx_camp_haul_cursor")
  @@map("camp_haul_records")
}

/// ACCEPTED/CHANGE_REQUESTED → өөрчлөгдөхгүй (trigger, service тойрно); хэн хүлээн авах = camp_settings.meal_order_*. Хүн-өдөр = Σ(base + extra) ÷ 3
model CampMealOrder {
  id                 String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId           String              @map("tenant_id") @db.Uuid
  campId             String              @map("camp_id") @db.Uuid
  orderDate          DateTime            @map("order_date") @db.Date
  /// DRAFT-д хоосон байж болно, ORDERED-оос заавал (MEAL гэрээ)
  mealContractItemId String?             @map("meal_contract_item_id") @db.Uuid
  status             CampMealOrderStatus @default(DRAFT)
  note               String?
  orderedBy          String?             @map("ordered_by") @db.Uuid
  orderedAt          DateTime?           @map("ordered_at") @db.Timestamptz
  reviewedBy         String?             @map("reviewed_by") @db.Uuid
  reviewedAt         DateTime?           @map("reviewed_at") @db.Timestamptz
  rejectReason       String?             @map("reject_reason")
  /// 20261107003: cutoff-оос хойш илгээсэн (APPROVAL горим)
  isLate             Boolean             @default(false) @map("is_late")
  /// TWO_SIDED: санал болгосон мөрүүд [{mealType, mealLocationId, baseCount}] (CHANGE_REQUESTED үед л)
  pendingLines       Json?               @map("pending_lines")
  changeReason       String?             @map("change_reason")
  revisionNo         Int                 @default(0) @map("revision_no") @db.SmallInt
  revisedAt          DateTime?           @map("revised_at") @db.Timestamptz
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  camp             Camp                @relation(fields: [tenantId, campId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_meal_orders_camp")
  mealContractItem CampContractItem?   @relation(fields: [tenantId, campId, mealContractItemId], references: [tenantId, campId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_meal_orders_contract")
  orderedByUser    CoreUser?           @relation("CampMealOrderOrderedBy", fields: [tenantId, orderedBy], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_meal_orders_ordered_by")
  reviewedByUser   CoreUser?           @relation("CampMealOrderReviewedBy", fields: [tenantId, reviewedBy], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_meal_orders_reviewed_by")
  lines            CampMealOrderLine[]
  extras           CampMealOrderExtra[]
  costEntries      CampCostEntry[]

  @@unique([tenantId, id], map: "uq_camp_meal_orders_tenant_id")
  @@unique([tenantId, campId, id], map: "uq_camp_meal_orders_camp_id")
  @@unique([tenantId, campId, orderDate], map: "uq_camp_meal_orders_day")
  @@index([tenantId, campId, status, orderDate], map: "idx_camp_meal_orders_status")
  @@map("camp_meal_orders")
}

/// base = захиалах үеийн тооцоолсон snapshot, extra = менежерийн залруулга (±); base + extra >= 0
model CampMealOrderLine {
  id             String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  campId         String       @map("camp_id") @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  mealType       CampMealType @map("meal_type")
  /// snapshot — хэлтсийн байршил хожим солигдсон ч өөрчлөгдөхгүй
  mealLocationId String       @map("meal_location_id") @db.Uuid
  baseCount      Int          @default(0) @map("base_count")
  extraCount     Int          @default(0) @map("extra_count")
  extraNote      String?      @map("extra_note")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order        CampMealOrder    @relation(fields: [tenantId, campId, orderId], references: [tenantId, campId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_camp_meal_order_lines_order")
  mealLocation CampMealLocation @relation(fields: [tenantId, campId, mealLocationId], references: [tenantId, campId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_meal_order_lines_location")

  @@unique([orderId, mealType, mealLocationId], map: "uq_camp_meal_order_lines")
  @@index([tenantId, orderId], map: "idx_camp_meal_order_lines_order")
  @@map("camp_meal_order_lines")
}

/// Тайлангийн цорын ганц эх сурвалж — snapshot, засагдахгүй (trigger). source бүрт яг нэг FK (CHECK).
/// Давхардал: partial unique (haul+service / meal / part) — migration-д
model CampCostEntry {
  id                String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId          String           @map("tenant_id") @db.Uuid
  campId            String           @map("camp_id") @db.Uuid
  costDate          DateTime         @map("cost_date") @db.Date
  source            CampCostSource
  haulRecordId      String?          @map("haul_record_id") @db.Uuid
  mealOrderId       String?          @map("meal_order_id") @db.Uuid
  maintenancePartId String?          @map("maintenance_part_id") @db.Uuid
  /// 6б: каталогийн кодын snapshot (camp_service_types.code)
  serviceType       String?          @map("service_type")
  contractItemId    String?          @map("contract_item_id") @db.Uuid
  organizationId    String?          @map("organization_id") @db.Uuid
  description       String?
  quantity          Decimal          @db.Decimal(15, 4)
  unit              String
  unitPrice         Decimal          @map("unit_price") @db.Decimal(18, 2)
  vatIncluded       Boolean          @map("vat_included")
  vatRate           Decimal          @map("vat_rate") @db.Decimal(5, 2)
  netAmount         Decimal          @map("net_amount") @db.Decimal(18, 2)
  vatAmount         Decimal          @map("vat_amount") @db.Decimal(18, 2)
  grossAmount       Decimal          @map("gross_amount") @db.Decimal(18, 2)
  createdBy         String           @map("created_by") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  camp            Camp                 @relation(fields: [tenantId, campId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_cost_camp")
  haulRecord      CampHaulRecord?      @relation(fields: [tenantId, haulRecordId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_cost_haul")
  mealOrder       CampMealOrder?       @relation(fields: [tenantId, campId, mealOrderId], references: [tenantId, campId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_cost_meal")
  maintenancePart CampMaintenancePart? @relation(fields: [tenantId, maintenancePartId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_cost_part")
  contractItem    CampContractItem?    @relation(fields: [tenantId, campId, contractItemId], references: [tenantId, campId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_cost_contract_item")
  organization    CoreOrganization?    @relation(fields: [tenantId, organizationId], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_cost_org")
  createdByUser   CoreUser             @relation("CampCostEntryCreatedBy", fields: [tenantId, createdBy], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_cost_created_by")

  @@index([tenantId, campId, costDate], map: "idx_camp_cost_report")
  @@index([tenantId, organizationId, costDate], map: "idx_camp_cost_org")
  @@map("camp_cost_entries")
}

/// Зочин / нэмэлт хоол — гараар (G-2). Тайлбар заавал, хэн оруулсан (createdBy). Хүн-өдөр = Σ(base) + Σ(guest) ÷ 3
model CampMealOrderExtra {
  id             String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  campId         String       @map("camp_id") @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  mealType       CampMealType @map("meal_type")
  mealLocationId String       @map("meal_location_id") @db.Uuid
  guestCount     Int          @map("guest_count")
  note           String
  createdBy      String       @map("created_by") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order        CampMealOrder    @relation(fields: [tenantId, campId, orderId], references: [tenantId, campId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_camp_meal_extras_order")
  mealLocation CampMealLocation @relation(fields: [tenantId, campId, mealLocationId], references: [tenantId, campId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_meal_extras_location")
  createdByUser CoreUser        @relation("CampMealExtraCreatedBy", fields: [tenantId, createdBy], references: [tenantId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_meal_extras_created_by")

  @@index([tenantId, orderId], map: "idx_camp_meal_extras_order")
  @@map("camp_meal_order_extras")
}

/// Тогтмол загвар — meal_order_default_fill = TEMPLATE үед шинэ захиалгын анхдагч тоо
model CampMealOrderTemplate {
  id             String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  campId         String       @map("camp_id") @db.Uuid
  mealType       CampMealType @map("meal_type")
  mealLocationId String       @map("meal_location_id") @db.Uuid
  baseCount      Int          @map("base_count")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  camp         Camp             @relation(fields: [tenantId, campId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_camp_meal_tpl_camp")
  mealLocation CampMealLocation @relation(fields: [tenantId, campId, mealLocationId], references: [tenantId, campId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_camp_meal_tpl_location")

  @@unique([tenantId, campId, mealType, mealLocationId], map: "uq_camp_meal_tpl")
  @@map("camp_meal_order_templates")
}
