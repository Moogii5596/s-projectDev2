// Tenant-ийн ажлын байр — v0.2.4 SYS-03, ADR-008
model CoreSite {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  type      String
  code      String
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  camp   Camp?

  @@unique([tenantId, id], map: "uq_core_sites_tenant_id")
  @@unique([tenantId, code], map: "uq_core_sites_tenant_code")
  @@map("core_sites")
}
