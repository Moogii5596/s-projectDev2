#!/bin/sh
# S Project — pre-push hook (AGENTS.md §4, issue #15 / H8).
# `main`-д шууд push хийхийг хориглоно: `main`-д зөвхөн A0 PR-ээр merge хийнэ.
# GitHub Free + private repo-д branch protection байхгүй тул энэ hook нь хамгаалалтын нэг давхарга.
# Идэвхжүүлэлт: `pnpm install` → `prepare` → scripts/git-hooks/install.mjs (core.hooksPath).
# Tag push (PO-ийн release) болон бусад branch-д нөлөөлөхгүй.
#
# stdin: <local ref> <local sha> <remote ref> <remote sha>  (мөр бүрт нэг ref)

protected="refs/heads/main"
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "$protected" ]; then
    blocked=1
  fi
done

if [ "$blocked" -eq 1 ]; then
  echo "" >&2
  echo "✖ main руу шууд push хийхийг хориглосон (AGENTS.md §4)." >&2
  echo "  Branch үүсгэж (feat|fix|chore|docs/<#>-<товч>) PR нээнэ — merge-ийг A0 хийнэ." >&2
  echo "✖ Direct push to main is blocked. Open a PR from a feature branch instead." >&2
  echo "" >&2
  exit 1
fi

exit 0
